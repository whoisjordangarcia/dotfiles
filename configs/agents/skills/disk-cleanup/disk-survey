#!/usr/bin/env python3
"""disk-survey: a READ-ONLY survey of reclaimable developer disk space.

Finds regenerable build output (cargo target/, SwiftPM .build, node_modules, zig caches, python venvs),
user-level developer caches and agent scratchpads, ranks them by size, and says what would stop you
deleting each one (a symlink pointing into it, a running process inside it, a dir git does not ignore).
It prints the command that would reclaim each candidate and never runs it.

  disk-survey                      ranked table for ~/dev and ~
  disk-survey --live               refresh every 3 s: free space, per-candidate size and what you reclaimed
  disk-survey --json               machine-readable
  disk-survey --root DIR           scan DIR instead of ~/dev
  disk-survey --min-kb N           hide candidates smaller than N KB (default 100 MB)

Environment (used by the tests): DISK_SURVEY_HOME replaces ~, DISK_SURVEY_TMP replaces /private/tmp.
"""

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

MAX_DEPTH = 5
DEFAULT_MIN_KB = 100 * 1024

# (marker file in the project dir, artifact dir name, kind, extra note)
PROJECT_ARTIFACTS = [
    ("Cargo.toml", "target", "cargo-target", ""),
    ("Package.swift", ".build", "swiftpm-build", ""),
    ("package.json", "node_modules", "node-modules", "reinstall with npm ci / pnpm i"),
    ("build.zig", ".zig-cache", "zig-cache", ""),
    ("build.zig", "zig-out", "zig-out", ""),
    ("build.zig.zon", "zig-pkg", "zig-pkg", "dependencies are re-downloaded (needs network)"),
    ("pyvenv.cfg", "", "python-venv", "recreate the venv afterwards"),
]

# (kind, path relative to home, risk, reclaim command, note)
USER_CACHES = [
    ("cargo-registry", ".cargo/registry", "safe", "rm -rf ~/.cargo/registry/cache ~/.cargo/registry/src", "crates are re-downloaded"),
    ("cargo-git", ".cargo/git", "safe", "rm -rf ~/.cargo/git", "git dependencies are re-fetched"),
    ("zig-global-cache", ".cache/zig", "safe", "rm -rf ~/.cache/zig", "rebuilt on the next zig build"),
    ("go-build-cache", "Library/Caches/go-build", "safe", "go clean -cache", ""),
    ("homebrew-cache", "Library/Caches/Homebrew", "safe", "brew cleanup -s", ""),
    ("pip-cache", "Library/Caches/pip", "safe", "pip cache purge", ""),
    ("yarn-cache", "Library/Caches/Yarn", "safe", "yarn cache clean", ""),
    ("npm-cache", ".npm/_cacache", "safe", "npm cache clean --force", ""),
    ("gradle-cache", ".gradle/caches", "safe", "rm -rf ~/.gradle/caches", "re-downloaded on the next build"),
    ("xcode-derived-data", "Library/Developer/Xcode/DerivedData", "safe", "rm -rf ~/Library/Developer/Xcode/DerivedData/*", "close Xcode first"),
    ("xcode-archives", "Library/Developer/Xcode/Archives", "caution", "", "archives are release builds you may want to keep"),
    ("ios-simulators", "Library/Developer/CoreSimulator/Devices", "caution", "xcrun simctl delete unavailable", "deletes simulator data"),
]


def home_dir():
    return os.environ.get("DISK_SURVEY_HOME") or os.path.expanduser("~")


def tmp_dir():
    return os.environ.get("DISK_SURVEY_TMP") or ("/private/tmp" if os.path.isdir("/private/tmp") else "/tmp")


def run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def du_kb(path):
    out = run(["du", "-sk", path], timeout=300)
    try:
        return int(out.split()[0])
    except (IndexError, ValueError):
        return 0


def under(path, parent):
    return path == parent or path.startswith(parent.rstrip("/") + "/")


# ---------------------------------------------------------------- discovery

def find_project_artifacts(root):
    """Walk root (depth-limited), return [(path, kind, project_dir, note)] without descending into artifacts."""
    found, symlinks = [], []
    root = os.path.realpath(root)
    if not os.path.isdir(root):
        return found, symlinks
    base_depth = root.rstrip("/").count("/")
    for cur, dirs, files in os.walk(root, followlinks=False):
        depth = cur.count("/") - base_depth
        names = set(dirs) | set(files)
        # symlinks living in this dir (to detect links INTO a candidate)
        for n in names:
            p = os.path.join(cur, n)
            if os.path.islink(p):
                symlinks.append(p)
        artifact_dirs = set()
        for marker, art, kind, note in PROJECT_ARTIFACTS:
            if marker not in names:
                continue
            if art == "":
                found.append((cur, kind, cur, note))
                artifact_dirs.update(dirs)  # a venv: do not descend
                continue
            if art in dirs:
                found.append((os.path.join(cur, art), kind, cur, note))
                artifact_dirs.add(art)
        if any(n.endswith((".xcodeproj", ".xcworkspace")) for n in names):
            for d in dirs:
                if d == "build" or d.startswith("build-") or d == "DerivedData":
                    found.append((os.path.join(cur, d), "xcode-build", cur, ""))
                    artifact_dirs.add(d)
        dirs[:] = [
            d for d in dirs
            if d not in artifact_dirs and d not in (".git", "vendor", "node_modules", "target", ".build")
            and not os.path.islink(os.path.join(cur, d)) and depth < MAX_DEPTH
        ]
    return found, symlinks


def find_user_caches(home):
    out = []
    for kind, rel, risk, reclaim, note in USER_CACHES:
        p = os.path.join(home, rel)
        if os.path.isdir(p):
            out.append({"path": p, "kind": kind, "risk": risk, "reclaim": reclaim or f"rm -rf {shlex.quote(p)}",
                        "note": note, "blockers": [], "project": None})
    return out


def find_generic_caches(home, explicit):
    """Immediate children of ~/.cache and ~/Library/Caches that the explicit list does not already cover."""
    out, covered = [], {os.path.realpath(c["path"]) for c in explicit}
    for rel in (".cache", "Library/Caches"):
        base = os.path.join(home, rel)
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            p = os.path.join(base, name)
            if not os.path.isdir(p) or os.path.islink(p) or os.path.realpath(p) in covered:
                continue
            out.append({"path": p, "kind": "user-cache", "risk": "safe", "reclaim": f"rm -rf {shlex.quote(p)}",
                        "note": "a cache: the owning tool rebuilds it (quit that app first)", "blockers": [],
                        "project": None})
    return out


def find_scratchpads(tmp):
    out = []
    if not os.path.isdir(tmp):
        return out
    for cur, dirs, _ in os.walk(tmp):
        if cur.count("/") - tmp.rstrip("/").count("/") > 4:
            dirs[:] = []
            continue
        if os.path.basename(cur) == "scratchpad":
            out.append({"path": cur, "kind": "agent-scratchpad", "risk": "caution",
                        "reclaim": f"rm -rf {shlex.quote(cur)}", "project": None,
                        "note": "an agent session's scratch files; make sure that session is finished",
                        "blockers": ["agent scratchpad: it may belong to a session that is still running"]})
            dirs[:] = []
    return out


def running_cwds():
    """[(pid, command, cwd)] for every process we can see."""
    out = run(["lsof", "-a", "-d", "cwd", "-Fpcn"], timeout=30)
    procs, pid, cmd = [], None, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("c"):
            cmd = line[1:]
        elif line.startswith("n") and pid:
            procs.append((pid, cmd or "?", line[1:]))
    return procs


def running_commands():
    """[(pid, command line)] for every process: catches programs that RUN FROM a path (cwd elsewhere)."""
    out = run(["ps", "-axo", "pid=,command="], timeout=30)
    me = str(os.getpid())
    procs = []
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0] != me:
            procs.append((parts[0], parts[1]))
    return procs


def git_ignored(project, name):
    """True/False, or None when git cannot tell (not a repo / git missing)."""
    if not shutil.which("git"):
        return None
    r = subprocess.run(["git", "-C", project, "check-ignore", "-q", name], capture_output=True)
    if r.returncode == 0:
        return True
    if r.returncode == 1:
        return False
    return None


def blockers_for(path, kind, project, symlinks, procs, cmds=()):
    blockers = []
    real = os.path.realpath(path)
    for link in symlinks:
        try:
            target = os.path.realpath(link)
        except OSError:
            continue
        if under(target, real) and not under(link, real):
            blockers.append(f"symlink {link} points into it")
    scope = os.path.realpath(project) if project else real
    inside = [(pid, cmd) for pid, cmd, cwd in procs if under(os.path.realpath(cwd), scope)]
    if inside:
        names = sorted({cmd for _, cmd in inside})
        shown = ", ".join(names[:4]) + (", ..." if len(names) > 4 else "")
        noun = "process has" if len(inside) == 1 else "processes have"
        blockers.append(f"{len(inside)} {noun} {scope} as their working directory ({shown}); "
                        f"check with: lsof +d {shlex.quote(scope)}")
    spellings = {path.rstrip("/"), real.rstrip("/")}  # ps shows the path as typed, not the resolved one
    running = [pid for pid, command in cmds
               if any(sp + "/" in command or command.endswith(sp) for sp in spellings)]
    if running:
        blockers.append(f"{len(running)} running command line{'s' if len(running) != 1 else ''} reference it "
                        f"(pid {', '.join(running[:4])}{', ...' if len(running) > 4 else ''}): "
                        f"a program is running from this path; check with: ps -p {running[0]} -o command=")
    if project and kind != "python-venv":
        ign = git_ignored(project, os.path.basename(path))
        if ign is False:
            blockers.append("not git-ignored: it may be tracked or hand-made, not just build output")
        elif ign is None:
            blockers.append("not in a git repo, so git cannot confirm it is generated")
    return blockers


def reclaim_for(path, kind, project):
    if kind == "cargo-target":
        return f"cargo clean --manifest-path {shlex.quote(os.path.join(project, 'Cargo.toml'))}"
    return f"rm -rf {shlex.quote(path)}"


def discover(root, home, tmp):
    artifacts, symlinks = find_project_artifacts(root)
    for extra in (os.path.join(home, ".local/bin"), os.path.join(home, ".cargo/bin"), os.path.join(home, "bin")):
        if os.path.isdir(extra):
            symlinks += [os.path.join(extra, n) for n in os.listdir(extra) if os.path.islink(os.path.join(extra, n))]
    procs = running_cwds()
    cmds = running_commands()
    cands = []
    for path, kind, project, note in artifacts:
        cands.append({"path": path, "kind": kind, "project": project, "note": note,
                      "blockers": blockers_for(path, kind, project, symlinks, procs, cmds),
                      "reclaim": reclaim_for(path, kind, project)})
    explicit = find_user_caches(home)
    caches = explicit + find_generic_caches(home, explicit)
    for c in caches:  # caches have no project dir: only the running-command check applies
        c["blockers"] = blockers_for(c["path"], c["kind"], None, [], [], cmds)
    cands += caches + find_scratchpads(tmp)
    with ThreadPoolExecutor(max_workers=8) as pool:
        for c, kb in zip(cands, pool.map(lambda c: du_kb(c["path"]), cands)):
            c["kb"] = kb
    for c in cands:
        c.setdefault("risk", "caution" if c["blockers"] else "safe")
        if c["blockers"]:
            c["risk"] = "caution"
    return cands


# ------------------------------------------------------------------ output

def human(kb):
    kb = max(kb, 0)
    for unit, div in (("GiB", 1024 * 1024), ("MiB", 1024), ("KiB", 1)):
        if kb >= div or unit == "KiB":
            return f"{kb / div:.1f} {unit}"


def disk_state(home):
    u = shutil.disk_usage(home)
    return u.free // 1024, u.total // 1024


def header(home, start_free=None):
    free, total = disk_state(home)
    used = 100 * (total - free) // max(total, 1)
    line = f"free {human(free)} of {human(total)} ({used}% used)"
    if start_free is not None:
        line += f"   reclaimed since start: {human(free - start_free)}"
    return line


def print_table(cands, top, show_detail=True, baseline=None):
    shown = cands[:top]
    for c in shown:
        tag = "SAFE   " if c["risk"] == "safe" else "CAUTION"
        size = human(c["kb"]) if os.path.exists(c["path"]) else "gone"
        delta = ""
        if baseline is not None and c["path"] in baseline:
            d = baseline[c["path"]] - c["kb"]
            if d > 0:
                delta = f"  (-{human(d)})"
        print(f"{size:>10}  {tag}  {c['kind']:<18} {c['path']}{delta}")
        if show_detail and os.path.exists(c["path"]):
            for b in c["blockers"]:
                print(f"{'':>12}blocked: {b}")
            if c.get("note"):
                print(f"{'':>12}note: {c['note']}")
            print(f"{'':>12}reclaim: {c['reclaim']}   (not run)")
    rest = cands[top:]
    if rest:
        print(f"... and {len(rest)} more ({human(sum(c['kb'] for c in rest))})")


def totals(cands):
    safe = sum(c["kb"] for c in cands if c["risk"] == "safe")
    caution = sum(c["kb"] for c in cands if c["risk"] != "safe")
    return safe, caution


def live(root, home, tmp, cands, top, interval, count):
    start_free, _ = disk_state(home)
    baseline = {c["path"]: c["kb"] for c in cands}
    frame = 0
    while True:
        frame += 1
        if sys.stdout.isatty():
            sys.stdout.write("\033[H\033[2J")
        print(header(home, start_free))
        print(f"{time.strftime('%H:%M:%S')}  frame {frame}   (read-only; run the reclaim commands yourself)\n")
        with ThreadPoolExecutor(max_workers=8) as pool:
            sizes = list(pool.map(lambda c: du_kb(c["path"]) if os.path.exists(c["path"]) else 0, cands))
        for c, kb in zip(cands, sizes):
            c["kb"] = kb
        cands.sort(key=lambda c: (-c["kb"], c["path"]))
        print_table(cands, top, show_detail=False, baseline=baseline)
        sys.stdout.flush()
        if count and frame >= count:
            return
        time.sleep(interval)


def main():
    ap = argparse.ArgumentParser(description="Read-only survey of reclaimable developer disk space.")
    ap.add_argument("--root", default=os.path.join(home_dir(), "dev"))
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--live", action="store_true")
    ap.add_argument("--interval", type=float, default=3.0)
    ap.add_argument("--count", type=int, default=0, help="frames to draw in --live (0 = until Ctrl-C)")
    ap.add_argument("--top", type=int, default=25)
    ap.add_argument("--min-kb", type=int, default=DEFAULT_MIN_KB)
    args = ap.parse_args()

    home, tmp = home_dir(), tmp_dir()
    cands = [c for c in discover(args.root, home, tmp) if c["kb"] >= args.min_kb]
    cands.sort(key=lambda c: (-c["kb"], c["path"]))

    if args.json:
        free, total = disk_state(home)
        print(json.dumps({"free_kb": free, "total_kb": total, "candidates": cands}, indent=2))
        return 0
    if args.live:
        try:
            live(args.root, home, tmp, cands, args.top, args.interval, args.count)
        except KeyboardInterrupt:
            pass
        return 0

    print(header(home))
    print()
    print_table(cands, args.top)
    safe, caution = totals(cands)
    print(f"\nsafe to reclaim: {human(safe)}    needs a look first: {human(caution)}    (nothing was deleted)")
    return 0


if __name__ == "__main__":
    sys.exit(main())

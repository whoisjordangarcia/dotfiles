#!/usr/bin/env bash
# gpu-switch - Switch between integrated and dedicated GPUs on MacBook Pro
# Based on https://github.com/0xbb/gpu-switch (Copyright (c) 2014-2015 Bruno Bierbaumer, Andreas Heider)
# GPU change requires reboot; the matching Hyprland perf profile is applied live.

set -euo pipefail

readonly sysfs_efi_vars='/sys/firmware/efi/efivars'
readonly efi_gpu='gpu-power-prefs-fa4ce28d-b62f-4c99-9cc3-6815686e30f9'

usage(){
  cat <<EOF
Usage:
  $(basename "$0") -i, --integrated       Switch to the integrated GPU (intel profile)
  $(basename "$0") -d, --dedicated        Switch to the dedicated GPU (amd profile)
  $(basename "$0") -p, --profile <name>   Only switch the Hyprland perf profile
                                          (intel|amd) — applies live, no reboot
  $(basename "$0") -s, --status           Show current GPU setting and active profile
  $(basename "$0") -h, --help             Show this message

Switches between the integrated and dedicated graphics cards of a dual-GPU
MacBook Pro for the next reboot, and retargets ~/.config/hypr/gpu-perf.conf
to the matching profile, hot-reloading Hyprland when it's running.
EOF
}

# The EFI write needs root, but the symlink and hyprctl must act as the
# invoking user — resolve identity through SUDO_USER (sudo) or PKEXEC_UID (pkexec).
if [ -n "${SUDO_USER:-}" ]; then
  target_user="$SUDO_USER"
elif [ -n "${PKEXEC_UID:-}" ]; then
  target_user=$(id -un "$PKEXEC_UID")
else
  target_user="$USER"
fi
user_home=$(getent passwd "$target_user" | cut -d: -f6)
hypr_dir="$user_home/.config/hypr"

run_as_user(){
  if [ "$(id -u)" -eq 0 ] && [ "$target_user" != "root" ]; then
    sudo -u "$target_user" "$@"
  else
    "$@"
  fi
}

check_efi(){
  if ! [ -d /sys/firmware/efi ]; then
    printf "Fatal: %s has to be run in EFI mode.\n" "$(basename "$0")" 1>&2
    exit 1
  fi

  if ! mount | grep -q "$sysfs_efi_vars"; then
    if ! mount -t efivarfs none "$sysfs_efi_vars"; then
      printf "Fatal: Couldn't mount '%s'.\n" "$sysfs_efi_vars" 1>&2
      exit 1
    fi
  fi
}

switch_gpu(){
  check_efi
  chattr -i "${sysfs_efi_vars}/${efi_gpu}" 2> /dev/null
  printf "\x07\x00\x00\x00\x${1}\x00\x00\x00" > "${sysfs_efi_vars}/${efi_gpu}"
}

set_profile(){
  local profile="$1"
  local target="$hypr_dir/gpu-perf-${profile}.conf"

  if ! [ -f "$target" ]; then
    printf "Fatal: profile '%s' not found at %s\n" "$profile" "$target" 1>&2
    exit 1
  fi

  run_as_user ln -sfn "$target" "$hypr_dir/gpu-perf.conf"
  printf "Hyprland perf profile -> %s\n" "$profile"

  if pgrep -x Hyprland >/dev/null 2>&1; then
    local uid
    uid=$(id -u "$target_user")
    if run_as_user env XDG_RUNTIME_DIR="/run/user/$uid" hyprctl reload >/dev/null 2>&1; then
      printf "Hyprland reloaded — profile applied live.\n"
    else
      printf "Warning: couldn't reload Hyprland; profile applies on next start.\n" 1>&2
    fi
  fi
}

show_status(){
  check_efi
  local val
  val=$(od -A n -t x1 -j 4 -N 1 "${sysfs_efi_vars}/${efi_gpu}" 2>/dev/null | tr -d ' ')
  case "$val" in
    01) printf "gpu: integrated\n" ;;
    00) printf "gpu: dedicated\n" ;;
    *)  printf "gpu: unknown (0x%s)\n" "$val" ;;
  esac
  if [ -L "$hypr_dir/gpu-perf.conf" ]; then
    printf "profile: %s\n" "$(basename "$(readlink "$hypr_dir/gpu-perf.conf")" .conf | sed 's/^gpu-perf-//')"
  else
    printf "profile: none\n"
  fi
}

if [ $# -lt 1 ]; then
  usage 1>&2
  exit 1
fi

case "$1" in
  -i|--integrated)
    switch_gpu 1
    set_profile intel
    printf "Switched to integrated GPU. Reboot to apply.\n"
  ;;
  -d|--dedicated)
    switch_gpu 0
    set_profile amd
    printf "Switched to dedicated GPU. Reboot to apply.\n"
  ;;
  -p|--profile)
    if [ $# -ne 2 ] || { [ "$2" != intel ] && [ "$2" != amd ]; }; then
      printf "Usage: %s --profile intel|amd\n" "$(basename "$0")" 1>&2
      exit 1
    fi
    set_profile "$2"
  ;;
  -s|--status)
    show_status
  ;;
  -h|--help)
    usage
  ;;
  *)
    usage 1>&2
    exit 1
  ;;
esac

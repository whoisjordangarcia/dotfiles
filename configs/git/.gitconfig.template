[user]
  name = __DOT_NAME__
  email = __DOT_EMAIL__
	signingkey = __DOT_YUBIKEY__

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  # 1Password signs via its SSH agent, so the private key never sits on disk.
  # script/git/setup.sh rewrites this to plain ssh-keygen on non-macOS.
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  allowedSignersFile = ~/.ssh/allowed_signers

[init]
  defaultBranch = main

[core]
  # System ssh for transport — brew openssh (needed for FIDO signing) shadows
  # it in PATH but rejects Apple-only config options like UseKeychain
  sshCommand = /usr/bin/ssh
  editor = nvim
  autocrlf = input 
  safecrlf = true
  filemode = false 
	pager = bat
  excludesfile = ~/.gitignore_global

[color]
  ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[push]
  default = current 
  
[pull]
  rebase = false 

[fetch]
  prune = true

[includeIf "gitdir:~/projects/"]
  path = ~/projects/.gitconfig


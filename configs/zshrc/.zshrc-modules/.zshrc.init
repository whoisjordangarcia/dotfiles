# ==============================================================================
#  Cached init helper — avoids spawning subprocesses on every shell start
# ==============================================================================
# Caches output of "tool init zsh" commands in ~/.cache/zsh/.
# Cache invalidates when the binary's modification time changes.
zmodload zsh/stat 2>/dev/null

_cached_init() {
  local cmd=$1; shift
  local cache_dir="${HOME}/.cache/zsh"
  local bin_path="${commands[$cmd]}"
  [[ -z "$bin_path" ]] && return 1

  local cache_file="${cache_dir}/${cmd}.zsh"
  local stamp_file="${cache_dir}/${cmd}.stamp"
  local bin_mtime
  zstat -A bin_mtime +mtime "$bin_path" 2>/dev/null || return 1

  if [[ -f "$cache_file" && -f "$stamp_file" && "$(<"$stamp_file")" == "$bin_mtime" ]]; then
    source "$cache_file"
  else
    mkdir -p "$cache_dir"
    "$cmd" "$@" > "$cache_file"
    echo "$bin_mtime" > "$stamp_file"
    source "$cache_file"
  fi
}

export STARSHIP_CONFIG=~/.config/starship.toml
export STARSHIP_LOG=error # scan_timeout bails are intentional; don't warn

# Load prompt/keybinding integrations only for real terminal sessions. This keeps
# `zsh -i -c ...` fast and avoids ZLE/TERM=dumb errors in scripted invocations.
if [[ -t 1 && "$TERM" != "dumb" ]]; then
  _cached_init starship init zsh

  # Build the PR hyperlink here, not in prompt_info.sh: starship's zsh escaper
  # mis-parses OSC 8 and closes its %{…%} region mid-URL, so the URL tail gets
  # counted as visible width and the prompt math (wrapping, redraw) breaks.
  # prompt_info.sh emits \001<url>\002 … \003 sentinels; we swap in the escapes
  # with correct zero-width markers.
  #
  # This wraps starship's PROMPT rather than rewriting it in a precmd hook:
  # under promptsubst starship sets PROMPT to a *deferred* '$(starship prompt
  # …)' substitution that zsh re-evaluates on each redraw, so at precmd time
  # there is no rendered string to patch. ${(e)…} evaluates the stashed
  # substitution verbatim, which keeps starship's own (upgrade-prone) argument
  # list out of this file.
  #
  # STARSHIP_PR_LINK tells prompt_info.sh the sentinels will actually be
  # rewritten; without it the bare URL would render as visible prompt text
  # (e.g. a shell started before this existed), so it falls back to a plain,
  # unlinked "●#1234".
  export STARSHIP_PR_LINK=1
  _starship_pr_prompt_raw=$PROMPT
  _starship_pr_prompt() {
    local p=${(e)_starship_pr_prompt_raw}
    if [[ $p == *$'\001'* ]]; then
      p=${p//$'\001'/$'%{\e]8;;'}
      p=${p//$'\002'/$'\e\\%}'}
      p=${p//$'\003'/$'%{\e]8;;\e\\%}'}
    fi
    print -rn -- $p
  }
  PROMPT='$(_starship_pr_prompt)'
fi

# Load zoxide (cached)
_cached_init zoxide init zsh

# Load fzf shell integration (cached)
if [[ -t 0 && -t 1 && "$TERM" != "dumb" ]]; then
  _cached_init fzf --zsh
fi

# ==============================================================================
#  Lightweight node version manager (replaces nvm for speed)
# ==============================================================================
# Uses nvm's installed versions at ~/.nvm/versions/node/ but skips the full
# nvm.sh load on startup. Default MUST match where the setup scripts install
# (script/{node,codex,claude}/setup.sh all use $HOME/.nvm) — otherwise node and
# its global bins (codex, claude) silently fall back to Homebrew node.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

_node_use() {
  local version_dir="$NVM_DIR/versions/node"
  local target="${${1#v}%%[[:space:]]*}"  # Strip 'v' prefix and whitespace

  # Find best matching installed version (prefix match, pick latest)
  local matches=("$version_dir"/v${target}*(N))  # (N) = nullglob, no error if no match
  if (( ${#matches} == 0 )); then
    echo "node: v${target} not installed. Installed:" >&2
    command ls "$version_dir" 2>/dev/null >&2
    return 1
  fi
  local match=${matches[-1]}  # Last element = highest version after glob sort

  # Remove any existing node version from PATH, add new one
  path=(${match}/bin ${path:#*${version_dir}*})
}

# Auto-switch node version on cd when .nvmrc exists
_auto_node_switch() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.nvmrc" ]]; then
      local want="${$(<"$dir/.nvmrc")#v}"
      local current="${$(node --version 2>/dev/null)#v}"
      # Only switch if major version differs
      if [[ "${current%%.*}" != "${want%%.*}" ]]; then
        _node_use "$want" 2>/dev/null  # Silence errors for missing versions
      fi
      return
    fi
    dir="${dir:h}"
  done
}

# Note: the startup invocation of the lightweight node manager
# (default-version resolution + chpwd hook) lives in .zshrc.paths,
# so it runs *after* `brew shellenv` and its PATH prepend wins.

# Lazy wrapper — full nvm.sh loads only on first `nvm` invocation.
# _node_use / _auto_node_switch above handle the 99% case (point PATH at
# an installed version, switch on cd when .nvmrc changes). nvm.sh itself
# costs ~1.5s on interactive start, so we defer it.
nvm() {
  unset -f nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}
